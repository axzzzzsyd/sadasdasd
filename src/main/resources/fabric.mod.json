{"schemaVersion": 1, "id": "donutsmp-addon", "version": "${version}", "name": "DonutSMP Addon", "description": "Base hunting tools for DonutSMP. Includes chunk finder, amethyst cluster finder, stash detector, and new-chunk detector. Axz debug.", "authors": ["Axz"], "contact": {"sources": "https://github.com/Axz/donutsmp-addon"}, "icon": "assets/donutsmp/icon.png", "environment": "client", "entrypoints": {"meteor": ["com.donutsmp.addon.DonutSMPAddon"]}, "mixins": ["donutsmp-addon.mixins.json"], "custom": {"meteor-client:color": "255,120,40", "modmenu": {"parent": {"id": "meteor-client"}}}, "depends": {"java": ">=${jdk_version}", "minecraft": "${minecraft_version}", "meteor-client": "*"}}